{
  "name": "@zovara/api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/server.js",
    "test": "tsx --test test/*.test.ts",
    "lint": "tsc --noEmit -p tsconfig.json",
    "db:migrate": "tsx ../../scripts/database/migrate.ts",
    "db:status": "tsx ../../scripts/database/status.ts",
    "db:seed": "tsx ../../scripts/database/seed.ts"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.926.0",
    "@fastify/cors": "^11.1.0",
    "@fastify/jwt": "^10.0.0",
    "@fastify/multipart": "^9.3.0",
    "@fastify/rate-limit": "^10.3.0",
    "@fastify/static": "^8.2.0",
    "bcryptjs": "^3.0.2",
    "dotenv": "^17.2.2",
    "fastify": "5.12.7",
    "fastify-raw-body": "^5.0.0",
    "livekit-server-sdk": "2.19.2",
    "pg": "^8.16.3",
    "stripe": "^18.5.0",
    "zod": "^4.1.12"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/node": "^22.18.6",
    "@types/pg": "^8.15.5",
    "tsx": "^4.20.5",
    "typescript": "~5.9.3"
  }
}
