{
  "name": "zovara",
  "version": "0.1.0",
  "private": true,
  "description": "Unified ZOVARA social platform monorepo",
  "license": "UNLICENSED",
  "engines": {
    "node": ">=22.16.0"
  },
  "packageManager": "pnpm@10.18.3",
  "scripts": {
    "start": "node --env-file-if-exists=.env services/api/src/server.mjs",
    "dev": "node --env-file-if-exists=.env --watch services/api/src/server.mjs",
    "test": "node --test tests/*.test.mjs",
    "verify": "node scripts/verify.mjs",
    "verify:styles": "node scripts/verify-styles.mjs",
    "catalog:seeds": "node scripts/generate-catalog-seeds.mjs",
    "inventory": "node scripts/generate-inventory.mjs",
    "check": "npm run verify && npm test",
    "lint": "node scripts/lint.mjs",
    "typecheck": "node scripts/typecheck.mjs",
    "styles:verify": "node scripts/verify-styles.mjs",
    "security:scan": "node scripts/scan-secrets.mjs"
  }
}
