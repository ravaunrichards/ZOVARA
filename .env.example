# Copy to .env for local API execution. Never commit .env.
NODE_ENV=development
PORT=3000
PUBLIC_APP_URL=http://localhost:3000
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Supabase project values. Service role is server-only and must never enter a client bundle.
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# PayPal REST API. Production processing is enabled only with explicit production credentials.
PAYPAL_ENVIRONMENT=sandbox
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
PAYPAL_WEBHOOK_ID=
PAYPAL_PAYOUTS_ENABLED=false
PAYPAL_PAYOUTS_CURRENCY=USD

# LiveKit server credentials. Never expose API secret in client config.
LIVEKIT_URL=
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=
LIVEKIT_DEFAULT_ROOM_MAX_PARTICIPANTS=100

# Storage/media pipeline. Configure a private Supabase Storage bucket named media.
SUPABASE_MEDIA_BUCKET=media
MAX_UPLOAD_BYTES=524288000

# Operational controls
TRUST_PROXY=false
LOG_LEVEL=info
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX_REQUESTS=120
COIN_CUSTOM_MIN=100
COIN_CUSTOM_MAX=1000000
COIN_PRICE_PER_100_USD=1.00
CREATOR_SHARE_BPS=5000
