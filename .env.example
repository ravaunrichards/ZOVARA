# Operational controls
TRUST_PROXY=false
LOG_LEVEL=info
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX_REQUESTS=120
COIN_CUSTOM_MIN=100
COIN_CUSTOM_MAX=1000000
COIN_PRICE_PER_100_USD=1.00
CREATOR_SHARE_BPS=5000
