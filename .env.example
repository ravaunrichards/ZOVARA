# Copy to .env for local API execution. Replace every REPLACE_WITH value with a real
# provider-issued value before using provider-backed features. Never commit .env.
NODE_ENV=development
PORT=3000
PUBLIC_APP_URL=http://localhost:3000
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Supabase project values. Service role is server-only and must never enter a client bundle.
SUPABASE_URL=https://jbgaahrgbmulbmfpybda.supabase.co
SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJpc3MiOiJzdXBhYmFzZSIsInJlZiI6ImpiZ2FhaHJnYm11bGJtZnB5YmRhIiwicm9sZSI6ImFub24iLCJpYXQiOjE3OTMzMjQ4NzEsImV4cCI6MjEwODkwMDg3MX0._-p4DglBaLGl8Y5YnC5Pf_rwyNNJjtalNlC4J3-rCJs
SUPABASE_SERVICE_ROLE_KEY=REPLACE_WITH_ZOVARA_SUPABASE_SERVICE_ROLE_KEY

# PayPal REST API. Keep Sandbox until checkout, capture and webhooks are verified.
PAYPAL_ENVIRONMENT=sandbox
PAYPAL_CLIENT_ID=BAA6MVck1K2S-pqkqM037-0jgEMUVQYdDhcTIo-eITeHXNLEPPxFd2-t459y6kWwgns9ymN1kSw6cYpi1c
